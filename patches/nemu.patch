diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aa..f076480 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -19,6 +19,38 @@
 #include "vcompute_impl.h"
 #include "vcommon.h"
 
+// Both ordinary and threaded NEMU execute headers include this body. A macro
+// keeps the arithmetic identical without defining a function inside execute().
+// All sources and the optional old accumulator are read before the first write.
+#define CUSTOM_VDOT(accumulate) do { \
+  require_vector(true); \
+  if (vstart->val != 0) longjmp_exception(EX_II); \
+  /* Mirror the existing vector decoder's early legality checks. */ \
+  const unsigned custom_lmul = vtype->vlmul; \
+  if ((custom_lmul >= 1 && custom_lmul <= 3 && \
+       ((id_src1->reg | id_src2->reg | id_dest->reg) & ((1u << custom_lmul) - 1u))) || \
+      (!s->vm && id_dest->reg == 0)) longjmp_exception(EX_II); \
+  if (VLEN != 128 || vtype->vsew != 0 || vtype->vlmul != 0 || \
+      vl->val != 8 || !s->vm) { \
+    cpu.trapInfo.vdot_config_fault = true; \
+    longjmp_exception(EX_II); \
+  } \
+  const uint32_t old_accumulator = (accumulate) ? (uint32_t)vreg_l(id_dest->reg, 0) : 0; \
+  int32_t result = 0; \
+  for (int i = 0; i < 8; ++i) { \
+    result += (int32_t)(int8_t)vreg_b(id_src1->reg, i) * \
+              (int32_t)(int8_t)vreg_b(id_src2->reg, i); \
+  } \
+  vreg_l(id_dest->reg, 0) = old_accumulator + (uint32_t)result; \
+  vreg_l(id_dest->reg, 1) = 0; \
+  vstart->val = 0; \
+  vp_set_dirty(); \
+} while (0)
+
+def_EHelper(vdot) { CUSTOM_VDOT(false); }
+def_EHelper(vdot_acc) { CUSTOM_VDOT(true); }
+#undef CUSTOM_VDOT
+
 def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
