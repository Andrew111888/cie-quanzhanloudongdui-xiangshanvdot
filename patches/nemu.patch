diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aa..ddc865e 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -19,6 +19,33 @@
 #include "vcompute_impl.h"
 #include "vcommon.h"
 
+// Provisional CIE-2026 vdot.vv: low eight signed bytes -> signed32, rest zero.
+def_EHelper(vdot) {
+  require_vector(true);
+  // Nonzero arithmetic vstart is rejected by the core's decoder, which has
+  // the original instruction payload. Preserve ordinary illegal xtval here.
+  if (vstart->val != 0) {
+    longjmp_exception(EX_II);
+  }
+  if (VLEN != 128 || vtype->vsew != 0 || vtype->vlmul != 0 ||
+      vl->val != 8 || !s->vm) {
+    // The custom execution-unit configuration fault reports xtval=0.
+    // Keep ordinary decode/privilege illegal-instruction reporting unchanged.
+    cpu.trapInfo.vdot_config_fault = true;
+    longjmp_exception(EX_II);
+  }
+  int32_t result = 0;
+  // Read every source before writing vd: vd may alias either source (or v0).
+  for (int i = 0; i < 8; ++i) {
+    result += (int32_t)(int8_t)vreg_b(id_src1->reg, i) *
+              (int32_t)(int8_t)vreg_b(id_src2->reg, i);
+  }
+  vreg_l(id_dest->reg, 0) = (uint32_t)result;
+  vreg_l(id_dest->reg, 1) = 0;
+  vstart->val = 0;
+  vp_set_dirty();
+}
+
 def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
