@@ -0,0 +1,19 @@
+// SPDX-License-Identifier: MulanPSL-2.0
+package top
+
+import org.chipsalliance.cde.config.Config
+import system.SoCParamsKey
+import xiangshan.XSTileKey
+
+/** Experimental simulation configuration. Keep MinimalConfig's cache and vector
+  * execution topology; reduce L3 sets and use the soft page walker.
+  * This configuration has not yet been validated by an elaboration or run.
+  */
+class VdotSimConfig(n: Int = 1) extends Config(
+  new MinimalConfig(n).alter((site, here, up) => {
+    case XSTileKey => up(XSTileKey).map(_.copy(softPTW = true))
+    case SoCParamsKey => up(SoCParamsKey).copy(
+      L3CacheParamsOpt = up(SoCParamsKey).L3CacheParamsOpt.map(_.copy(sets = 128))
+    )
+  })
+)
